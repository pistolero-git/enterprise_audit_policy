# v0.14: preserve source execve rules; include the separate execveat syscall for privilege transitions.
# UBTU-22-654230 / V-260648 | V2R10 privilege objective; execveat is an enterprise extension, not literal STIG fix text
-a always,exit -F arch=b64 -S execveat -C uid!=euid -F euid=0 -k t1_execveat_priv
# UBTU-22-654230 / V-260648 | V2R10 privilege objective; execveat is an enterprise extension, not literal STIG fix text
-a always,exit -F arch=b64 -S execveat -C gid!=egid -F egid=0 -k t1_execveat_priv
