## V-270795 — Ubuntu 24.04 LTS must generate audit records for successful/unsuccessful uses of the chacl command.
# OPTIONAL PACKAGE PREREQUISITE: /usr/bin/chacl is provided by Ubuntu acl;
# validate installation before loading this STIG-derived executable watch.
# Source: https://packages.ubuntu.com/noble/amd64/acl/filelist
-a always,exit -F path=/usr/bin/chacl -F perm=x -F auid>=1000 -F auid!=-1 -k perm_chng

## V-270807 — Ubuntu 24.04 LTS must generate audit records when successful/unsuccessful attempts to modify the /etc/sudoers file occur
-w /etc/sudoers -p wa -k privilege_modification

## V-270808 — Ubuntu 24.04 LTS must generate audit records when successful/unsuccessful attempts to modify the /etc/sudoers.d director
-w /etc/sudoers.d -p wa -k privilege_modification

## V-270809 — Ubuntu 24.04 LTS must generate audit records for any successful/unsuccessful use of unlink, unlinkat, rename, renameat, 
-a always,exit -F arch=b64 -S unlink,unlinkat,rename,renameat,rmdir -F auid>=1000 -F auid!=-1 -k delete
-a always,exit -F arch=b32 -S unlink,unlinkat,rename,renameat,rmdir -F auid>=1000 -F auid!=-1 -k delete

# v0.13: preserve source execve rules; include the separate execveat syscall for privilege transitions.
-a always,exit -F arch=b64 -S execveat -C uid!=euid -F euid=0 -k t1_execveat_priv
-a always,exit -F arch=b64 -S execveat -C gid!=egid -F egid=0 -k t1_execveat_priv
-a always,exit -F arch=b32 -S execveat -C uid!=euid -F euid=0 -k t1_execveat_priv
-a always,exit -F arch=b32 -S execveat -C gid!=egid -F egid=0 -k t1_execveat_priv
