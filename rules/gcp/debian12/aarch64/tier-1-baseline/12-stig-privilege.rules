# TARGET ARCHITECTURE: aarch64 (ARM64) | v0.16.4 | gcp/debian12
# ARM64-specific syscall mapping; reconcile against this product/version ARM64 STIG or approved baseline.
# Enterprise Linux Audit v0.16.4  |  [gcp/debian12]
# Tier: tier-1-baseline
# Purpose: privilege transitions and sudo policy changes
# Source/authority: DISA applicable product STIG/SRG objective; linux-audit sample rules
# Architecture: aarch64 (b64 only). No x86/compat b32 syscall rules.
# Release state: engineering candidate; NOT independently certified STIG compliant.


-a always,exit -F arch=b64 -S execve -C uid!=euid -F euid=0 -k t1_privexec
-a always,exit -F arch=b64 -S execve -C gid!=egid -F egid=0 -k t1_privexec
# OPTIONAL if sudo installed:
# -a always,exit -F arch=b64 -F path=/etc/sudoers -F perm=wa -k t1_sudoers
# -a always,exit -F arch=b64 -F dir=/etc/sudoers.d -F perm=wa -k t1_sudoers
# Host-specific privileged executables may require additional STIG-derived rules.

# v0.14: preserve source execve rules; include the separate execveat syscall for privilege transitions.
-a always,exit -F arch=b64 -S execveat -C uid!=euid -F euid=0 -k t1_execveat_priv
-a always,exit -F arch=b64 -S execveat -C gid!=egid -F egid=0 -k t1_execveat_priv

# Debian enterprise baseline: privileged-command execution (package-path candidate).
-a always,exit -F path=/usr/bin/mount -F perm=x -F auid>=1000 -F auid!=unset -k privileged-mount
-a always,exit -F path=/usr/bin/umount -F perm=x -F auid>=1000 -F auid!=unset -k privileged-umount

# CONDITIONAL: activate applicable paths after verifying installed Debian package contents.
# Requires sudo package; not guaranteed on Debian minimal; do not claim covered until enabled.
# -a always,exit -F path=/usr/bin/sudo -F perm=x -F auid>=1000 -F auid!=unset -k privileged-sudo
# Requires sudo package; do not claim covered until enabled.
# -a always,exit -F path=/usr/bin/sudoedit -F perm=x -F auid>=1000 -F auid!=unset -k privileged-sudoedit
# Requires openssh-client package; do not claim covered until enabled.
# -a always,exit -F path=/usr/bin/ssh-agent -F perm=x -F auid>=1000 -F auid!=unset -k privileged-ssh
# Requires openssh-client package; do not claim covered until enabled.
# -a always,exit -F path=/usr/lib/openssh/ssh-keysign -F perm=x -F auid>=1000 -F auid!=unset -k privileged-ssh
# Requires acl package; do not claim covered until enabled.
# -a always,exit -F path=/usr/bin/setfacl -F perm=x -F auid>=1000 -F auid!=unset -k perm_chng
# Requires acl package; do not claim covered until enabled.
# -a always,exit -F path=/usr/bin/chacl -F perm=x -F auid>=1000 -F auid!=unset -k perm_chng
# Requires selinux-utils package; do not claim covered until enabled.
# -a always,exit -F path=/usr/bin/chcon -F perm=x -F auid>=1000 -F auid!=unset -k perm_chng

# Universal Debian privilege policy changes: parent directory must exist.
# Conditional to sudo package: -a always,exit -F dir=/etc/sudoers.d -F perm=wa -k t1_sudoers_change
