# TARGET ARCHITECTURE: x86_64 | v0.18 | gcp/debian13
# Enterprise Linux Audit v0.18  |  [gcp/debian13]
# Tier: tier-1-baseline
# Purpose: permission, deletion, module, time, and failed-file-access audit
# Source/authority: DISA applicable product STIG/SRG objectives; linux-audit audit-userspace 30-stig.rules
# Architecture: x86_64 (b64 native, b32 compatibility); use aarch64/ subprofile for ARM64.
# Release state: engineering candidate; NOT independently certified STIG compliant.


-a always,exit -F arch=b64 -S chmod,fchmod,fchmodat -F auid>=1000 -F auid!=unset -k t1_perm_mod
-a always,exit -F arch=b64 -S chown,fchown,fchownat,lchown -F auid>=1000 -F auid!=unset -k t1_perm_mod
-a always,exit -F arch=b64 -S setxattr,fsetxattr,lsetxattr,removexattr,fremovexattr,lremovexattr -F auid>=1000 -F auid!=unset -k t1_xattr
-a always,exit -F arch=b64 -S rename,renameat,unlink,unlinkat,rmdir -F auid>=1000 -F auid!=unset -k t1_delete
-a always,exit -F arch=b64 -S openat,creat,truncate,ftruncate -F exit=-EACCES -F auid>=1000 -F auid!=unset -k t1_access_fail
-a always,exit -F arch=b64 -S openat,creat,truncate,ftruncate -F exit=-EPERM -F auid>=1000 -F auid!=unset -k t1_access_fail
-a always,exit -F arch=b64 -S init_module,finit_module,delete_module -F auid>=1000 -F auid!=unset -k t1_module
-a always,exit -F arch=b64 -S adjtimex,settimeofday,clock_settime -F auid>=1000 -F auid!=unset -k t1_time
# Broader syscall coverage may be required by the exact product STIG; reconcile it before compliance approval.

# v0.14: modern syscall and mount/privilege telemetry; enterprise coverage, not a STIG attestation
-a always,exit -F arch=b64 -S openat2 -F exit=-EACCES -F auid>=1000 -F auid!=unset -k t1_access_fail_modern
-a always,exit -F arch=b64 -S openat2 -F exit=-EPERM -F auid>=1000 -F auid!=unset -k t1_access_fail_modern
-a always,exit -F arch=b64 -S renameat2 -F auid>=1000 -F auid!=unset -k t1_delete_modern
-a always,exit -F arch=b64 -S fchmodat2 -F auid>=1000 -F auid!=unset -k t1_perm_mod_modern
-a always,exit -F arch=b64 -S mount,umount2 -F auid>=1000 -F auid!=unset -k t1_mount
-a always,exit -F arch=b64 -S setgid,setregid,setresgid -F auid>=1000 -F auid!=unset -k t1_group_priv

# v0.14: x86_64 compat ABI Tier 1 syscall counterparts; check OS STIG applicability.
-a always,exit -F arch=b32 -S chmod,fchmod,fchmodat -F auid>=1000 -F auid!=unset -k t1_perm_mod
-a always,exit -F arch=b32 -S chown,fchown,fchownat,lchown -F auid>=1000 -F auid!=unset -k t1_perm_mod
-a always,exit -F arch=b32 -S setxattr,fsetxattr,lsetxattr,removexattr,fremovexattr,lremovexattr -F auid>=1000 -F auid!=unset -k t1_xattr
-a always,exit -F arch=b32 -S rename,renameat,unlink,unlinkat,rmdir -F auid>=1000 -F auid!=unset -k t1_delete
-a always,exit -F arch=b32 -S openat,creat,truncate,ftruncate -F exit=-EACCES -F auid>=1000 -F auid!=unset -k t1_access_fail
-a always,exit -F arch=b32 -S openat,creat,truncate,ftruncate -F exit=-EPERM -F auid>=1000 -F auid!=unset -k t1_access_fail
-a always,exit -F arch=b32 -S init_module,finit_module,delete_module -F auid>=1000 -F auid!=unset -k t1_module
-a always,exit -F arch=b32 -S adjtimex,settimeofday,clock_settime -F auid>=1000 -F auid!=unset -k t1_time
-a always,exit -F arch=b32 -S openat2 -F exit=-EACCES -F auid>=1000 -F auid!=unset -k t1_access_fail_modern
-a always,exit -F arch=b32 -S openat2 -F exit=-EPERM -F auid>=1000 -F auid!=unset -k t1_access_fail_modern
-a always,exit -F arch=b32 -S renameat2 -F auid>=1000 -F auid!=unset -k t1_delete_modern
-a always,exit -F arch=b32 -S fchmodat2 -F auid>=1000 -F auid!=unset -k t1_perm_mod_modern
-a always,exit -F arch=b32 -S mount,umount2 -F auid>=1000 -F auid!=unset -k t1_mount
-a always,exit -F arch=b32 -S setgid,setregid,setresgid -F auid>=1000 -F auid!=unset -k t1_group_priv

# Enterprise parity: root logged-in user permission/xattr changes; supplement existing auid>=1000 rules.
-a always,exit -F arch=b64 -S setxattr,fsetxattr,lsetxattr,removexattr,fremovexattr,lremovexattr -F auid=0 -k t1_root_xattr
-a always,exit -F arch=b64 -S open,open_by_handle_at -F exit=-EACCES -F auid>=1000 -F auid!=unset -k t1_access_fail
-a always,exit -F arch=b64 -S open,open_by_handle_at -F exit=-EPERM -F auid>=1000 -F auid!=unset -k t1_access_fail
-a always,exit -F arch=b32 -S setxattr,fsetxattr,lsetxattr,removexattr,fremovexattr,lremovexattr -F auid=0 -k t1_root_xattr
-a always,exit -F arch=b32 -S open,open_by_handle_at -F exit=-EACCES -F auid>=1000 -F auid!=unset -k t1_access_fail
-a always,exit -F arch=b32 -S open,open_by_handle_at -F exit=-EPERM -F auid>=1000 -F auid!=unset -k t1_access_fail

# v0.15: privileged kernel-module activity without depending on kmod/modprobe executables.
# Daemon-originated root activity has auid=unset; this rule captures sessions with auid=0.
-a always,exit -F arch=b64 -S init_module,finit_module,delete_module -F auid=0 -k t1_module_root
-a always,exit -F arch=b64 -S init_module,finit_module,delete_module -F auid=unset -k t1_module_daemon
-a always,exit -F arch=b32 -S init_module,finit_module,delete_module -F auid=0 -k t1_module_root
-a always,exit -F arch=b32 -S init_module,finit_module,delete_module -F auid=unset -k t1_module_daemon

# CONDITIONAL managed Debian / Proxmox prerequisites (not active on stock/minimal images):
# kmod package: https://packages.debian.org/trixie/amd64/kmod/filelist
# -a always,exit -F path=/usr/sbin/modprobe -F perm=x -F auid>=1000 -F auid!=unset -k t1_modprobe_exec
# -a always,exit -F path=/usr/bin/kmod -F perm=x -F auid>=1000 -F auid!=unset -k t1_kmod_exec
# fdisk package: https://packages.debian.org/trixie/amd64/fdisk/filelist
# -a always,exit -F path=/usr/sbin/fdisk -F perm=x -F auid>=1000 -F auid!=unset -k t1_fdisk_exec
# cron package and active spool paths are not guaranteed in Debian cloud/minimal:
# -w /etc/cron.d -p wa -k t1_cronjobs
# -w /var/spool/cron -p wa -k t1_cronjobs
# Persistent journald requires /var/log/journal to exist (Storage=auto will otherwise be volatile):
# -w /var/log/journal -p wa -k t1_systemd_journal
# Additional optional kernel-module and persistence paths:
# -w /etc/modprobe.d -p wa -k t1_module_policy
