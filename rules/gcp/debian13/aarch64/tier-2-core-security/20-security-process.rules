# TARGET ARCHITECTURE: aarch64 (ARM64) | v0.19 | gcp/debian13
# ARM64-specific syscall mapping; reconcile against this product/version ARM64 STIG or approved baseline.
# Enterprise Linux Audit v0.17  |  [gcp/debian13]
# Tier: tier-2-core-security
# Purpose: security administration process activity
# Source/authority: Enterprise SOC/IR minimum
# Architecture: aarch64 (b64 only). No x86/compat b32 syscall rules.
# Release state: engineering candidate; NOT independently certified STIG compliant.


# Selective execution coverage of privilege-relevant syscalls.
-a always,exit -F arch=b64 -S setuid,setreuid,setresuid -F auid>=1000 -F auid!=unset -k t2_privilege_api
# OPTIONAL commands by exact path (enable only when installed):
# -a always,exit -F path=/usr/bin/systemctl -F perm=x -F auid>=1000 -F auid!=unset -k t2_service_admin
# -a always,exit -F path=/usr/sbin/auditctl -F perm=x -F auid>=1000 -F auid!=unset -k t2_audit_admin
# Debian-family package tooling (enable only if installed):
# -a always,exit -F path=/usr/bin/apt-get -F perm=x -F auid>=1000 -F auid!=unset -k t2_pkg_admin
# -a always,exit -F path=/usr/bin/dpkg -F perm=x -F auid>=1000 -F auid!=unset -k t2_pkg_admin
