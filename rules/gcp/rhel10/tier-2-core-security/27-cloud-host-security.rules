# TARGET ARCHITECTURE: x86_64 | v0.19 | gcp/rhel10
# Enterprise Linux Audit v0.16 | gcp/rhel10 | mandatory Tier 2 cloud host controls
# Source context: Google guest agent; Cloud Audit Logs required for firewall/IAM/API
# Host auditd cannot observe cloud-native API calls, security-group, IAM or NSG changes initiated remotely.
# Cloud native API logging is a mandatory companion; see Implementation Guide.
# No agent-specific path is assumed installed; missing agent paths MUST be assessed for this image.
# Monitors root daemon automation with unset loginuid (not normal interactive root sessions).
-a always,exit -F arch=b64 -S execve,execveat -F auid=unset -F euid=0 -k t2_gcp_daemon_exec
# Root-owned cloud daemon outbound connections; SOCKADDR does not expose cloud API operation semantics.
-a always,exit -F arch=b64 -S connect -F auid=unset -F euid=0 -k t2_gcp_daemon_connect
# Includes cloud-init/guest provisioning edits in /etc; not a substitute for exact agent watches.
-a always,exit -F arch=b64 -F dir=/etc -F perm=wa -F auid=unset -F euid=0 -k t2_gcp_root_config
# x86_64 compatibility ABI for daemon execution/connect where 32-bit emulation is enabled.
-a always,exit -F arch=b32 -S execve,execveat -F auid=unset -F euid=0 -k t2_gcp_daemon_exec
-a always,exit -F arch=b32 -S connect -F auid=unset -F euid=0 -k t2_gcp_daemon_connect

# Google guest-agent configuration precedence (highest first):
# /etc/default/instance_configs.cfg.template > .distro > base .cfg.
# Agent extension/plugin state: /var/lib/google-guest-agent (newer agents).
# The .cfg file can be user-created; paths are not universally installed.
# Source: https://docs.cloud.google.com/compute/docs/images/manage-guest-agent
# CONDITIONAL mandatory coverage: resolve installed paths on the target cloud image.
# The following watches are NOT automatically activated because a missing path may reject the rule.
# If component installed and relevant, activate its exact file/dir watch or document an approved N/A.
# -a always,exit -F arch=b64 -F path=/etc/default/instance_configs.cfg -F perm=wa -k t2_gcp_agent_conf
# -a always,exit -F arch=b64 -F path=/etc/default/instance_configs.cfg.distro -F perm=wa -k t2_gcp_agent_conf
# -a always,exit -F arch=b64 -F path=/etc/default/instance_configs.cfg.template -F perm=wa -k t2_gcp_agent_conf
# WARNING: agent plugin state may be high volume; activate only after volume assessment.
# -a always,exit -F arch=b64 -F dir=/var/lib/google-guest-agent -F perm=wa -k t2_gcp_agent_state
# -a always,exit -F arch=b64 -F dir=/etc/cloud -F perm=wa -k t2_gcp_agent_conf
# -a always,exit -F path=/usr/bin/gcloud -F perm=x -k t2_gcp_cli
# -a always,exit -F arch=b64 -F dir=/root/.config/gcloud -F perm=wa -k t2_gcp_agent_conf
