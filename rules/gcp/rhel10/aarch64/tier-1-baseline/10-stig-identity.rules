# TARGET ARCHITECTURE: aarch64 (ARM64) | v0.16.4 | gcp/rhel10
# ARM64-specific syscall mapping; reconcile against this product/version ARM64 STIG or approved baseline.
# Enterprise Linux Audit v0.16.4  |  [gcp/rhel10]
# Tier: tier-1-baseline
# Purpose: user/group account database modifications
# Source/authority: DISA applicable product STIG/SRG objective; Linux Audit upstream examples
# Architecture: aarch64 (b64 only). No x86/compat b32 syscall rules.
# Release state: engineering candidate; NOT independently certified STIG compliant.


-a always,exit -F arch=b64 -F path=/etc/passwd -F perm=wa -k t1_identity
-a always,exit -F arch=b64 -F path=/etc/shadow -F perm=wa -k t1_identity
-a always,exit -F arch=b64 -F path=/etc/group -F perm=wa -k t1_identity
-a always,exit -F arch=b64 -F path=/etc/gshadow -F perm=wa -k t1_identity
# OPTIONAL (requires existing file): /etc/security/opasswd
# -a always,exit -F arch=b64 -F path=/etc/security/opasswd -F perm=wa -k t1_identity

# v0.13: additional identity/authentication configuration monitoring (enterprise baseline)
-a always,exit -F arch=b64 -F path=/etc/nsswitch.conf -F perm=wa -k t1_identity_resolve
