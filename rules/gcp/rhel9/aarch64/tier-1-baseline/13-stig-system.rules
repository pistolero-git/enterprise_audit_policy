# TARGET ARCHITECTURE: aarch64 (ARM64) | v0.16.4 | gcp/rhel9
# RHEL 9 ARM translation from older local V2R10 source; not official ARM-compliance evidence.
# ARM64-specific syscall mapping; reconcile against this product/version ARM64 STIG or approved baseline.
# Enterprise Linux Audit v0.16.4  |  [gcp/rhel9]
# Tier: tier-1-baseline
# Purpose: permission, deletion, module, time, and failed-file-access audit
# Source/authority: DISA applicable product STIG/SRG objectives; linux-audit audit-userspace 30-stig.rules
# Architecture: aarch64 (b64 only). No x86/compat b32 syscall rules.
# Release state: engineering candidate; NOT independently certified STIG compliant.

# PACKAGE PREFLIGHT: chacl and SELinux administration commands depend on optional utility packages.
# Verify RPM file manifests for the exact RHEL 9 repository/image; this
# source-derived STIG file preserves applicable rules rather than dropping them.

-a always,exit -F arch=b64 -S adjtimex,settimeofday,clock_settime -F auid>=1000 -F auid!=unset -k t1_time
# Broader syscall coverage may be required by the exact product STIG; reconcile it before compliance approval.

# v0.13 RHEL 9 candidate additions from prior RHEL 9 V2R10 source bundle.
# Prior bundle contained V-258176..V-258228; reconcile each current product STIG.
# Verify ALL referenced paths on this exact image before enabling; missing targets block loading.
-a always,exit -F arch=b64 -S fchmodat,fchmodat2,fchmod -F auid>=1000 -F auid!=unset -k perm_mod
-a always,exit -F arch=b64 -S fchownat,fchown -F auid>=1000 -F auid!=unset -k perm_mod
-a always,exit -F arch=b64 -S setxattr,fsetxattr,lsetxattr,removexattr,fremovexattr,lremovexattr -F auid>=1000 -F auid!=unset -k perm_mod
-a always,exit -F arch=b64 -S setxattr,fsetxattr,lsetxattr,removexattr,fremovexattr,lremovexattr -F auid=0 -k perm_mod
-a always,exit -F path=/usr/bin/chacl -F perm=x -F auid>=1000 -F auid!=unset -k perm_mod
-a always,exit -F path=/usr/bin/setfacl -F perm=x -F auid>=1000 -F auid!=unset -k perm_mod
-a always,exit -F path=/usr/bin/chcon -F perm=x -F auid>=1000 -F auid!=unset -k perm_mod
-a always,exit -F path=/usr/sbin/semanage -F perm=x -F auid>=1000 -F auid!=unset -k privileged-unix-update
-a always,exit -F path=/usr/sbin/setfiles -F perm=x -F auid>=1000 -F auid!=unset -k privileged-unix-update
-a always,exit -F path=/usr/sbin/setsebool -F perm=x -F auid>=1000 -F auid!=unset -F key=privileged
-a always,exit -F arch=b64 -S renameat,renameat2,unlinkat -F auid>=1000 -F auid!=unset -k delete
-a always,exit -F arch=b64 -S truncate,ftruncate,openat,openat2,open_by_handle_at -F exit=-EPERM -F auid>=1000 -F auid!=unset -k perm_access
-a always,exit -F arch=b64 -S truncate,ftruncate,openat,openat2,open_by_handle_at -F exit=-EACCES -F auid>=1000 -F auid!=unset -k perm_access
-a always,exit -F arch=b64 -S delete_module -F auid>=1000 -F auid!=unset -k module_chng
-a always,exit -F arch=b64 -S init_module,finit_module -F auid>=1000 -F auid!=unset -k module_chng
-a always,exit -F path=/usr/bin/kmod -F perm=x -F auid>=1000 -F auid!=unset -k modules
-a always,exit -F arch=b64 -S execve -F subj_type=crond_t -F euid=0 -k cron_exec
-a always,exit -F arch=b64 -S execve -F subj_type=crond_t -F auid>=1000 -F auid!=unset -k cron_exec

# v0.13: modern syscall and mount/privilege telemetry; enterprise coverage, not a STIG attestation
-a always,exit -F arch=b64 -S mount,umount2 -F auid>=1000 -F auid!=unset -k t1_mount
-a always,exit -F arch=b64 -S setgid,setregid,setresgid -F auid>=1000 -F auid!=unset -k t1_group_priv
