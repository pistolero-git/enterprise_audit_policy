# TARGET ARCHITECTURE: aarch64 (ARM64) | v0.17 | gcp/ubuntu2604
# Tier 1 target: Ubuntu 26.04 LTS (enterprise inheritance only)
# Engineering basis: Ubuntu 24.04 V1R7 audit objectives, not an exact source-rule extraction
# IMPORTANT: this profile is NOT an approved product STIG implementation.
# Vendor and STIG-specific path prerequisites must be met before deployment.
# ARM64-specific syscall mapping; reconcile against this product/version ARM64 STIG or approved baseline.
# Enterprise Linux Audit v0.16 | gcp/ubuntu2604
# Tier 1 — Ubuntu 26.04 candidate audit-rule candidate
# ARM64 variant is translated from a reviewer x86_64 source; independently validate ARM64 STIG applicability and paths.
# IMPORTANT: missing paths need remediation or approved N/A/exception; do not silently ignore errors.

## Functional area: kernel modules, partitioning, cron execution, systemd journal
-a always,exit -F arch=b64 -S init_module,finit_module -F auid>=1000 -F auid!=-1 -k module_chng

-a always,exit -F arch=b64 -S delete_module -F auid>=1000 -F auid!=-1 -k module_chng

-w /sbin/modprobe -p x -k modules

-w /bin/kmod -p x -k modules

-w /usr/sbin/fdisk -p x -k fdisk

## V-274870 — Ubuntu 26.04 candidate LTS must audit any script or executable called by cron as root or by any privileged user.
-w /etc/cron.d/ -p wa -k cronjobs
-w /var/spool/cron/ -p wa -k cronjobs

-w /var/log/journal -p wa -k systemd_journal

# Enterprise baseline — interactive-user system time adjustments.
-a always,exit -F arch=b64 -S adjtimex,settimeofday,clock_settime -F auid>=1000 -F auid!=unset -k t1_time

# v0.14: modern syscall and mount/privilege telemetry; enterprise coverage, not a STIG attestation
-a always,exit -F arch=b64 -S openat2 -F exit=-EACCES -F auid>=1000 -F auid!=unset -k t1_access_fail_modern
-a always,exit -F arch=b64 -S openat2 -F exit=-EPERM -F auid>=1000 -F auid!=unset -k t1_access_fail_modern
-a always,exit -F arch=b64 -S renameat2 -F auid>=1000 -F auid!=unset -k t1_delete_modern
-a always,exit -F arch=b64 -S fchmodat2 -F auid>=1000 -F auid!=unset -k t1_perm_mod_modern
-a always,exit -F arch=b64 -S mount,umount2 -F auid>=1000 -F auid!=unset -k t1_mount
-a always,exit -F arch=b64 -S setgid,setregid,setresgid -F auid>=1000 -F auid!=unset -k t1_group_priv
