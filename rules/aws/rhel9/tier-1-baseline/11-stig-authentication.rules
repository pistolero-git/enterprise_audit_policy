# TARGET ARCHITECTURE: x86_64 | v0.16.3 | aws/rhel9
# Enterprise Linux Audit v0.16.3  |  [aws/rhel9]
# Tier: tier-1-baseline
# Purpose: PAM/security authentication configuration
# Source/authority: DISA applicable product STIG/SRG objective; enterprise authentication coverage
# Architecture: x86_64 (b64 native, b32 compatibility); use aarch64/ subprofile for ARM64.
# Release state: engineering candidate; NOT independently certified STIG compliant.

# PACKAGE PREFLIGHT: pam_timestamp_check and unix_update depend on the installed PAM components.
# Verify RPM file manifests for the exact RHEL 9 repository/image; this
# source-derived STIG file preserves applicable rules rather than dropping them.

# PAM directory is expected for the supported full Linux VM/server image.
-a always,exit -F arch=b64 -F dir=/etc/pam.d -F perm=wa -k t1_authpolicy
# OPTIONAL when SSH server and /etc/ssh are installed:
# -a always,exit -F arch=b64 -F dir=/etc/ssh -F perm=wa -k t1_sshpolicy
# Successful/failed SSH logins are normally logged by sshd/PAM; forward those logs.
# Do not interpret these file-watch rules as a replacement for authentication logs.

# v0.13 RHEL 9 candidate additions from prior RHEL 9 V2R10 source bundle.
# Prior bundle contained V-258176..V-258228; reconcile each current product STIG.
# Verify ALL referenced paths on this exact image before enabling; missing targets block loading.
# Prior RHEL 9 V2R10 local reference: AUD-CMP-023 / V-258197; verify with current DISA source.
-a always,exit -F path=/usr/sbin/pam_timestamp_check -F perm=x -F auid>=1000 -F auid!=unset -k privileged-pam_timestamp_check
# Prior RHEL 9 V2R10 local reference: AUD-CMP-027 / V-258201; verify with current DISA source.
-a always,exit -F path=/usr/bin/ssh-agent -F perm=x -F auid>=1000 -F auid!=unset -k privileged-ssh
# Prior RHEL 9 V2R10 local reference: AUD-CMP-028 / V-258202; verify with current DISA source.
-a always,exit -F path=/usr/libexec/openssh/ssh-keysign -F perm=x -F auid>=1000 -F auid!=unset -k privileged-ssh
# Prior RHEL 9 V2R10 local reference: AUD-CMP-029 / V-258203; verify with current DISA source.
-a always,exit -F path=/usr/bin/su -F perm=x -F auid>=1000 -F auid!=unset -k privileged-priv_change
# Prior RHEL 9 V2R10 local reference: AUD-CMP-032 / V-258206; verify with current DISA source.
-a always,exit -F path=/usr/sbin/unix_chkpwd -F perm=x -F auid>=1000 -F auid!=unset -k privileged-unix-update
# Prior RHEL 9 V2R10 local reference: AUD-CMP-033 / V-258207; verify with current DISA source.
-a always,exit -F path=/usr/sbin/unix_update -F perm=x -F auid>=1000 -F auid!=unset -k privileged-unix-update

# v0.13: audit and PAM configuration tamper monitoring
-a always,exit -F arch=b64 -F dir=/etc/security -F perm=wa -k t1_pam_security
-a always,exit -F arch=b64 -F dir=/etc/audit -F perm=wa -k t1_audit_config
# Conditional: monitor /etc/ssh, /etc/sudoers and /etc/sudoers.d when present; missing paths must be addressed or waived.
# -a always,exit -F arch=b64 -F dir=/etc/ssh -F perm=wa -k t1_ssh_config
# -a always,exit -F arch=b64 -F path=/etc/sudoers -F perm=wa -k t1_sudo_config
# -a always,exit -F arch=b64 -F dir=/etc/sudoers.d -F perm=wa -k t1_sudo_config
