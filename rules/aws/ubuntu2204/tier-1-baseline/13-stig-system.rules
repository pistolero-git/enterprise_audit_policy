# Enterprise Linux Audit v0.16 | aws/ubuntu2204
# Tier 1 — Ubuntu 22.04 candidate audit-rule candidate
# IMPORTANT: missing paths need remediation or approved N/A/exception; do not silently ignore errors.

## Functional area: kernel modules, partitioning, cron execution, systemd journal
# UBTU-22-654175 / V-260637 | V2R10 published check/fix mapping; path/package prerequisites still require image validation
-a always,exit -F arch=b32 -S init_module,finit_module -F auid>=1000 -F auid!=-1 -k module_chng
# UBTU-22-654175 / V-260637 | V2R10 published check/fix mapping; path/package prerequisites still require image validation
-a always,exit -F arch=b64 -S init_module,finit_module -F auid>=1000 -F auid!=-1 -k module_chng

# UBTU-22-654170 / V-260636 | V2R10 published check/fix mapping; path/package prerequisites still require image validation
-a always,exit -F arch=b32 -S delete_module -F auid>=1000 -F auid!=-1 -k module_chng
# UBTU-22-654170 / V-260636 | V2R10 published check/fix mapping; path/package prerequisites still require image validation
-a always,exit -F arch=b64 -S delete_module -F auid>=1000 -F auid!=-1 -k module_chng

# UBTU-22-654060 / V-260614 | V2R10 published check/fix mapping; path/package prerequisites still require image validation
-w /sbin/modprobe -p x -k modules

# UBTU-22-654055 / V-260613 | V2R10 published check/fix mapping; path/package prerequisites still require image validation
-w /bin/kmod -p x -k modules

# UBTU-22-654045 / V-260611 | V2R10 published check/fix mapping; path/package prerequisites still require image validation
-w /usr/sbin/fdisk -p x -k fdisk

# UBTU-22-654041 / V-274862 | V2R10 published check/fix mapping; path/package prerequisites still require image validation
-w /etc/cron.d/ -p wa -k cronjobs
# UBTU-22-654041 / V-274862 | V2R10 published check/fix mapping; path/package prerequisites still require image validation
-w /var/spool/cron/ -p wa -k cronjobs

# UBTU-22-654190 / V-260640 | V2R10 published check/fix mapping; path/package prerequisites still require image validation
-w /var/log/journal -p wa -k systemd_journal

# Enterprise baseline — interactive-user system time adjustments.
-a always,exit -F arch=b64 -S adjtimex,settimeofday,clock_settime -F auid>=1000 -F auid!=unset -k t1_time

# v0.14: modern syscall and mount/privilege telemetry; enterprise coverage, not a STIG attestation
-a always,exit -F arch=b64 -S openat2 -F exit=-EACCES -F auid>=1000 -F auid!=unset -k t1_access_fail_modern
-a always,exit -F arch=b64 -S openat2 -F exit=-EPERM -F auid>=1000 -F auid!=unset -k t1_access_fail_modern
-a always,exit -F arch=b64 -S renameat2 -F auid>=1000 -F auid!=unset -k t1_delete_modern
-a always,exit -F arch=b64 -S fchmodat2 -F auid>=1000 -F auid!=unset -k t1_perm_mod_modern
-a always,exit -F arch=b64 -S mount,umount2 -F auid>=1000 -F auid!=unset -k t1_mount
-a always,exit -F arch=b64 -S setgid,setregid,setresgid -F auid>=1000 -F auid!=unset -k t1_group_priv

# v0.14: x86_64 compat ABI Tier 1 syscall counterparts; check OS STIG applicability.
-a always,exit -F arch=b32 -S adjtimex,settimeofday,clock_settime -F auid>=1000 -F auid!=unset -k t1_time
-a always,exit -F arch=b32 -S openat2 -F exit=-EACCES -F auid>=1000 -F auid!=unset -k t1_access_fail_modern
-a always,exit -F arch=b32 -S openat2 -F exit=-EPERM -F auid>=1000 -F auid!=unset -k t1_access_fail_modern
-a always,exit -F arch=b32 -S renameat2 -F auid>=1000 -F auid!=unset -k t1_delete_modern
-a always,exit -F arch=b32 -S fchmodat2 -F auid>=1000 -F auid!=unset -k t1_perm_mod_modern
-a always,exit -F arch=b32 -S mount,umount2 -F auid>=1000 -F auid!=unset -k t1_mount
-a always,exit -F arch=b32 -S setgid,setregid,setresgid -F auid>=1000 -F auid!=unset -k t1_group_priv
