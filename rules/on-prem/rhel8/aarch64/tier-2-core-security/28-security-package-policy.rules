# TARGET ARCHITECTURE: aarch64 (ARM64) | v0.19 | on-prem/rhel8
# ARM64-specific syscall mapping; reconcile against this product/version ARM64 STIG or approved baseline.
# Enterprise Linux Audit v0.17  |  [on-prem/rhel8]
# Tier: tier-2-core-security
# Purpose: package repository tampering
# Source/authority: Enterprise SOC/IR minimum; distro package manager vendor documentation
# Architecture: aarch64 (b64 only). No x86/compat b32 syscall rules.
# Release state: engineering candidate; NOT independently certified STIG compliant.


# RPM-family repository config changes (path normally exists).
-a always,exit -F arch=b64 -F dir=/etc/yum.repos.d -F perm=wa -k t2_pkg_repo
# OPTIONAL if present: /etc/dnf/dnf.conf and /etc/dnf/dnf5-plugins
# -a always,exit -F arch=b64 -F path=/etc/dnf/dnf.conf -F perm=wa -k t2_pkg_repo
