# TARGET ARCHITECTURE: x86_64 | v0.18 | azure/ubuntu2404
# Enterprise Linux Audit v0.18  |  [azure/ubuntu2404]
# Tier: tier-1-baseline
# Purpose: MAC administrative policy changes and enforcement context
# Source/authority: DISA applicable product STIG/SRG as applicable; vendor SELinux/AppArmor docs
# Architecture: x86_64 (b64 native, b32 compatibility); use aarch64/ subprofile for ARM64.
# Release state: engineering candidate; NOT independently certified STIG compliant.


# AppArmor policies; AppArmor denials are logged through audit/journal/syslog as configured.
-a always,exit -F arch=b64 -F dir=/etc/apparmor.d -F perm=wa -k t1_apparmor_policy
# STIG V1R7 V-270793 / UBTU-24-900220: audit apparmor_parser execution.
# Ubuntu 24.04 apparmor package manifest lists /sbin/apparmor_parser; DO NOT
# substitute the Ubuntu 26.04 /usr/sbin path without verifying this image.
# Source: https://packages.ubuntu.com/noble/all/apparmor/filelist
# A missing /sbin/apparmor_parser requires investigation/remediation/waiver, not silent omission.
-a always,exit -F path=/sbin/apparmor_parser -F perm=x -F auid>=1000 -F auid!=-1 -k perm_chng
